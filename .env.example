DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_wb_analytics
# Set to 'disable' for local dev without SSL; omit (defaults to require) for production
DATABASE_SSL=disable
PG_POOL_MAX=15
PG_IDLE_TIMEOUT=20
PG_MAX_LIFETIME=1800
PG_CONNECT_TIMEOUT=10
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL_INTERNAL=http://127.0.0.1:54321
ENCRYPTION_KEY=replace-with-64-char-hex-key
APP_BASE_URL=https://enterprise-wb-analytics.example.com
APP_RESET_URL=https://enterprise-wb-analytics.example.com/reset-password
# Default package created automatically for a newly connected cabinet so the
# admin panel can track onboarding/subscription state before real billing.
ONBOARDING_DEFAULT_PLAN_CODE=growth
ONBOARDING_TRIAL_DAYS=3
# Comma-separated hosts allowed to appear in password-reset redirect URLs built
# from x-forwarded-host. Any other host falls back to APP_BASE_URL (prevents
# host-header open-redirect).
# Example: ALLOWED_HOSTS=про-цифры.рф,процифры.рф
ALLOWED_HOSTS=
# Tenants with no successful sync for this many days are treated as dormant and
# not alerted by the stale-sync cron. Default: 14.
SYNC_DORMANT_DAYS=14

# --- Observability (Sentry) ---
# Leave SENTRY_DSN empty to disable Sentry completely (instrumentation.ts is a
# no-op when DSN is unset). Fill both server and public DSN to enable:
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# 0.0 = no tracing, 1.0 = 100% of requests. Default 0.1 = 10% sampling.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional — for release tagging in Sentry. Ideally set in CI/deploy script:
SENTRY_RELEASE=

TELEGRAM_BOT_TOKEN=
# Bot username without @, used to build safe deep-link binding URLs in Settings.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Security default: report commands with cabinet data work only in private chats.
# Set to true only for explicitly trusted tenant group chats.
TELEGRAM_ALLOW_GROUP_REPORT_COMMANDS=false
# Optional. If empty, ops-watchdog still runs but logs alerts locally instead of
# delivering them to Telegram.
TELEGRAM_OPS_CHAT_ID=
# Private agent/reporting API. Leave empty to disable.
# Simple single-client mode:
AGENT_API_KEY=
AGENT_API_CLIENT_ID=telegram-main
AGENT_API_ALLOWED_REPORTS=dashboard_summary,unit_economics_summary,sync_status
# Optional comma-separated tenant UUID allowlist. Empty = all tenants reachable by this key.
AGENT_API_ALLOWED_TENANT_IDS=
AGENT_API_ALLOWED_CABINET_OIDS=
AGENT_API_WORKER_ID=
AGENT_API_ROLES=
# Advanced multi-client mode (overrides the simple vars above when set):
# AGENT_API_CLIENTS=[{"id":"telegram-main","key":"replace-with-long-secret","reports":["dashboard_summary","unit_economics_summary","sync_status"],"tenantIds":["00000000-0000-0000-0000-000000000000"]},{"id":"procifry-dima","key":"replace-with-long-secret","workerId":"wb-data-integrator","roles":["read_all_wb_digitization","write_analysis","write_tasks","request_approval"],"tenantIds":["00000000-0000-0000-0000-000000000000"],"cabinetOids":["lavrov-main"]},{"id":"procifry-operator","key":"replace-with-long-secret","workerId":"wb-procifry-operator","roles":["read_all_wb_digitization","write_analysis","write_tasks","write_drafts","write_scenarios","request_approval"],"tenantIds":["00000000-0000-0000-0000-000000000000","11111111-1111-4111-8111-111111111111"],"cabinetOids":["lavrov-main","berbeka-main"]}]
AGENT_API_CLIENTS=
# Hard cap for autonomous Procifry ad balance top-ups.
PROCIFRY_AD_AGENT_MAX_DEPOSIT_RUB=10000
# Procifry Agent API smoke. Uses AGENT_API_KEY / AGENT_API_ALLOWED_TENANT_IDS
# as fallback when these dedicated variables are empty.
PROCIFRY_AGENT_BASE_URL=http://localhost:3000
PROCIFRY_AGENT_API_KEY=
PROCIFRY_SMOKE_TENANT_IDS=
PROCIFRY_SMOKE_REPORTS=
PROCIFRY_SMOKE_DATE_FROM=
PROCIFRY_SMOKE_DATE_TO=
PROCIFRY_SMOKE_STRICT_REPORTS=1
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
# Optional, defaults to yandexgpt/latest
YANDEX_GPT_MODEL_NAME=
# Production self-hosted Inngest runtime:
# - set INNGEST_BASE_URL=http://127.0.0.1:8288 when using the local signed runtime
# - do not set INNGEST_DEV in production
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional server-only override for anon key (defaults to NEXT_PUBLIC_SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY_INTERNAL=

# Scheduled WB sync profiles
WB_SYNC_FAST_CRON=0 * * * *
WB_SYNC_MEDIUM_CRON=15 */2 * * *
WB_SYNC_NIGHTLY_CRON=10 2 * * *
WB_SYNC_ACTIVE_LOCK_MINUTES=60
# WB Advertising API global pacing for endpoints except fullstats, which has its own 20s rule.
WB_AD_API_MIN_INTERVAL_MS=1100
# WB reviews/questions publish pacing to reduce answer API 429s.
WB_FEEDBACK_ANSWER_MIN_INTERVAL_MS=1500
WB_SYNC_STALE_TIMEOUT_MINUTES=60
AD_AUTO_BIDDER_CRON=*/20 * * * *
WB_SYNC_NIGHTLY_LOOKBACK_DAYS=91
WB_SUPPLY_WRITEOFF_CRON=30 20 * * *
WB_SUPPLY_WRITEOFF_LOOKBACK_DAYS=2
REVIEWS_QA_AUTO_REPLY_CRON=*/15 * * * *
REVIEWS_QA_AUTO_BATCH_SIZE=15
REVIEWS_QA_AUTO_TONE=friendly

# Signal SLA automations
SIGNAL_SLA_SWEEP_CRON=15 * * * *
SIGNAL_SLA_FOLLOW_UP_CRON=45 */2 * * *

# Redistribution daily digest and export
REDISTRIBUTION_DIGEST_CRON=30 3 * * *
REDISTRIBUTION_WINDOW_DAYS=91
REDISTRIBUTION_OUTPUT_DIR=./output/redistribution
REDISTRIBUTION_RPA_AUTO_QUEUE=false
REDISTRIBUTION_ROUTE_SCAN_CRON=35 6 * * *
REDISTRIBUTION_ROUTE_WAREHOUSE_LOOKBACK_DAYS=60
REDISTRIBUTION_ROUTE_LIMIT_TTL_HOURS=20
REDISTRIBUTION_ROUTE_UNAVAILABLE_TTL_DAYS=14
REDISTRIBUTION_ROUTE_AVAILABLE_TTL_DAYS=21
REDISTRIBUTION_SLOT_MONITOR_TICK_CRON=* * * * *
REDISTRIBUTION_SLOT_MONITOR_AGGRESSIVE_WINDOWS_MSK=08:40-10:30,11:55-12:20,15:55-16:20,17:55-18:20
REDISTRIBUTION_SLOT_MONITOR_AGGRESSIVE_START_MSK=08:55
REDISTRIBUTION_SLOT_MONITOR_AGGRESSIVE_END_MSK=10:30
REDISTRIBUTION_SLOT_MONITOR_BACKGROUND_INTERVAL_MIN=3
REDISTRIBUTION_SLOT_MONITOR_MAX_ROUTES_PER_TENANT=8
REDISTRIBUTION_SLOT_MONITOR_MAX_ROUTES_PER_TENANT_AGGRESSIVE=24
REDISTRIBUTION_SLOT_MONITOR_MAX_ROUTES_PER_TENANT_BACKGROUND=8
REDISTRIBUTION_SLOT_MONITOR_RECENT_HOURS=24
REDISTRIBUTION_SLOT_MONITOR_AUTO_SUBMIT=true
REDISTRIBUTION_SLOT_MONITOR_MATRIX=true
REDISTRIBUTION_SLOT_MONITOR_MATRIX_MAX_NM_PER_TENANT=5
REDISTRIBUTION_SLOT_MONITOR_MATRIX_MAX_ROUTES_PER_TENANT=300
REDISTRIBUTION_SLOT_MONITOR_HTTP_429_BACKOFF_MIN=6

# WB redistribution RPA upload (required only if REDISTRIBUTION_RPA_AUTO_QUEUE=true)
WB_RPA_DRY_RUN=true
WB_RPA_HEADLESS=true
WB_RPA_TIMEOUT_MS=90000
WB_RPA_LOGIN_URL=
WB_RPA_REDISTRIBUTION_URL=https://seller.wildberries.ru/analytics-reports/warehouse-remains
WB_RPA_LOGIN=
WB_RPA_LOGIN_SELECTOR=
WB_RPA_SUBMIT_SELECTOR=
WB_RPA_SMS_CODE_SELECTOR=
WB_RPA_SMS_SUBMIT_SELECTOR=
WB_RPA_LOGIN_SUCCESS_SELECTOR=

# Preferred WB flow: warehouse remains modal ("Перераспределить остатки")
WB_RPA_REDISTRIBUTION_TRIGGER_SELECTOR=button:has-text("Перераспределить остатки"), a:has-text("Перераспределить остатки"), button:has-text("Перераспределить"), a:has-text("Перераспределить"), [role="button"]:has-text("Перераспределить"), [data-testid*="redistribution" i], [class*="redistribution" i] button
WB_RPA_REDISTRIBUTION_DIALOG_SELECTOR='div[class*="Modal__"]:has-text("Перераспределить"), [role="dialog"]:has-text("Перераспределить"), div:has-text("Перераспределить остатки товара")'
WB_RPA_ARTICLE_SELECTOR=input[placeholder*="артикул"], input[placeholder*="Артикул"]
WB_RPA_ARTICLE_SEARCH_SELECTOR=input[name="search-name"], input#search[placeholder*="Поиск"]
WB_RPA_ARTICLE_OPTION_SELECTOR=button[class*="Dropdown-option"], li[class*="Dropdown-list__item"]:not([class*="--search"]), div[class*="Custom-nm-option"], [role="option"]
WB_RPA_ARTICLE_ALLOW_VENDOR_CODE_FALLBACK=true
WB_RPA_WAREHOUSE_INPUT_SELECTOR=input[placeholder*="Выберите склад"], input[placeholder*="выберите склад"]
WB_RPA_FROM_WAREHOUSE_SELECTOR=
WB_RPA_TO_WAREHOUSE_SELECTOR=
WB_RPA_REDISTRIBUTION_SUBMIT_SELECTOR=button:has-text("Перераспределить"), [role="button"]:has-text("Перераспределить")
WB_RPA_SIZE_SELECTOR=
WB_RPA_TRANSFER_UNITS_SELECTOR=
WB_RPA_FAILURE_RETENTION_DAYS=7
WB_RPA_FAILURE_MAX_FILES=1000

# Legacy CSV upload flow (only if your WB contour still exposes file upload)
WB_RPA_FILE_INPUT_SELECTOR=
WB_RPA_UPLOAD_SUBMIT_SELECTOR=
WB_RPA_SUCCESS_SELECTOR=
WB_RPA_SUCCESS_TEXT=

# Optional legacy login/password flow (if WB login form still requires password)
WB_RPA_PASSWORD=
WB_RPA_PASSWORD_SELECTOR=

# Ops watchdog (Telegram alerts for health/systemd/sync source failures)
OPS_WATCHDOG_HEALTH_URL=http://127.0.0.1:3457/api/health
OPS_WATCHDOG_SYSTEMD_UNITS=enterprise-wb-analytics.service,enterprise-wb-analytics-sync-worker.service,enterprise-wb-analytics-inngest.service,enterprise-wb-analytics-redistribution-worker.service,enterprise-wb-analytics-advertising-worker.service,enterprise-wb-analytics-reviews-worker.service,enterprise-wb-analytics-ops-worker.service,enterprise-wb-analytics-supabase.service,enterprise-wb-network-hardening.service,nginx.service,postgresql@17-main.service
OPS_WATCHDOG_AUTO_RECOVER_SYSTEMD=true
OPS_WATCHDOG_SYSTEMD_RECOVERY_UNITS=postgresql@17-main.service,docker.service,enterprise-wb-analytics-supabase.service,enterprise-wb-network-hardening.service,enterprise-wb-analytics.service,enterprise-wb-analytics-sync-worker.service,enterprise-wb-analytics-redistribution-worker.service,enterprise-wb-analytics-advertising-worker.service,enterprise-wb-analytics-reviews-worker.service,enterprise-wb-analytics-ops-worker.service,enterprise-wb-analytics-inngest.service,nginx.service
OPS_WATCHDOG_SYNC_LOOKBACK_MINUTES=45
OPS_WATCHDOG_SYNC_RUN_LIMIT=12
OPS_WATCHDOG_MAX_SYNC_KEYS=1200
OPS_WATCHDOG_STATE_PATH=./tmp/ops-watchdog-state.json

# Nightly DB backup + restore-test. Production systemd writes a dedicated
# .env.backup with local postgres peer URLs; BACKUP_RESTORE_DATABASE_URL must
# still point to a separate database so postdeploy expects the timer to be active.
BACKUP_DIR=./backups/db-nightly
BACKUP_RETENTION_DAYS=7
BACKUP_RESTORE_DATABASE_URL=
BACKUP_RESTORE_MIN_TABLES=10

# Smoke / Playwright artifacts
PLAYWRIGHT_SMOKE_RETENTION_DAYS=3
PLAYWRIGHT_SMOKE_MAX_DIRS=20

# Observability (P0-08)
# Structured logging level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info
# Sentry DSN — optional, activate when you have a Sentry SaaS account or self-hosted GlitchTip
# SENTRY_DSN=https://xxx@oNNN.ingest.sentry.io/NNNN
# Hours without a successful sync before a Telegram stale-sync alert is sent (default: 6)
SYNC_STALE_ALERT_HOURS=6
